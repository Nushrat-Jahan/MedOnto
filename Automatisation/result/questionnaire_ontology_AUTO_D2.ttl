# Généré automatiquement par le pipeline A2 (Qwen) -> B2 (BioPortal) -> C2 (Qwen) -> D2.
# On fait une comparaison manuelle avec le pipeline non automatisé
# Règle : owl:sameAs uniquement si le match C2 vaut "Exact" pour toutes les utilisations du concept.

@prefix :     <http://example.org/questionnaire-ontology#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/questionnaire-ontology> a owl:Ontology ;
    rdfs:label "Questionnaire ontology fragment AUTO (PHQ-9, GAD-7, ESS) - pipeline A2D2"@en .

########################################################################
# Classes
########################################################################
:Questionnaire     a owl:Class ; rdfs:label "Questionnaire"@en .
:QuestionnaireItem a owl:Class ; rdfs:label "Questionnaire item"@en .
:ClinicalConcept   a owl:Class ; rdfs:label "Clinical concept"@en .
:ResponseScale     a owl:Class ; rdfs:label "Response scale"@en .
:CandidateProjectConcept a owl:Class ;
    rdfs:subClassOf :ClinicalConcept ;
    rdfs:label "Candidate project concept"@en ;
    rdfs:comment "Clinical concept with no suitable SNOMED CT match found."@en .

########################################################################
# Propriétés
########################################################################
:hasItem a owl:ObjectProperty ;
    rdfs:label "has item"@en ;
    rdfs:domain :Questionnaire ;
    rdfs:range  :QuestionnaireItem .

:assesses a owl:ObjectProperty ;
    rdfs:label "assesses"@en ;
    rdfs:domain :QuestionnaireItem ;
    rdfs:range  :ClinicalConcept .

:hasResponseScale a owl:ObjectProperty ;
    rdfs:label "has response scale"@en ;
    rdfs:domain :QuestionnaireItem ;
    rdfs:range  :ResponseScale .

:itemId a owl:DatatypeProperty ;
    rdfs:domain :QuestionnaireItem ;
    rdfs:range  xsd:string .

:minScore a owl:DatatypeProperty ;
    rdfs:domain :ResponseScale ;
    rdfs:range  xsd:integer .

:maxScore a owl:DatatypeProperty ;
    rdfs:domain :ResponseScale ;
    rdfs:range  xsd:integer .

:responseLabels a owl:DatatypeProperty ;
    rdfs:domain :ResponseScale ;
    rdfs:range  xsd:string .

########################################################################
# Questionnaires
########################################################################
:PHQ9 a :Questionnaire ;
    rdfs:label "PHQ-9"@en ;
    :hasItem :PHQ9_Item2, :PHQ9_Item4, :PHQ9_Item7, :PHQ9_Item9 .

:GAD7 a :Questionnaire ;
    rdfs:label "GAD-7"@en ;
    :hasItem :GAD7_Item1, :GAD7_Item4, :GAD7_Item6 .

:ESS a :Questionnaire ;
    rdfs:label "Epworth Sleepiness Scale"@en ;
    :hasItem :ESS_Item4, :ESS_Item8 .

########################################################################
# Échelles de réponse
########################################################################
:PHQ9_ResponseScale a :ResponseScale ;
    rdfs:label "PHQ-9 response scale (frequency over the past 2 weeks)"@en ;
    :minScore 0 ; :maxScore 3 ;
    :responseLabels "0=Not at all, 1=Several days, 2=More than half the days, 3=Nearly every day" .

:GAD7_ResponseScale a :ResponseScale ;
    rdfs:label "GAD-7 response scale (frequency over the past 2 weeks)"@en ;
    :minScore 0 ; :maxScore 3 ;
    :responseLabels "0=Not at all, 1=Several days, 2=More than half the days, 3=Nearly every day" .

:ESS_ResponseScale a :ResponseScale ;
    rdfs:label "ESS response scale (chance of dozing)"@en ;
    :minScore 0 ; :maxScore 3 ;
    :responseLabels "0=Would never doze, 1=Slight chance of dozing, 2=Moderate chance of dozing, 3=High chance of dozing" .

########################################################################
# Items
########################################################################
:PHQ9_Item2 a :QuestionnaireItem ;
    :itemId "phq2" ;
    rdfs:label "Feeling down, depressed, or hopeless"@en ;
    :assesses :MildDepression ;
    :hasResponseScale :PHQ9_ResponseScale .

:PHQ9_Item4 a :QuestionnaireItem ;
    :itemId "phq4" ;
    rdfs:label "Feeling tired or having little energy"@en ;
    :assesses :Fatigue ;
    :hasResponseScale :PHQ9_ResponseScale .

:PHQ9_Item7 a :QuestionnaireItem ;
    :itemId "phq7" ;
    rdfs:label "Trouble concentrating on things, such as reading the newspaper or watching television"@en ;
    :assesses :AttentionDeficitHyperactivityDisorderCombinedType ;
    :hasResponseScale :PHQ9_ResponseScale .

:PHQ9_Item9 a :QuestionnaireItem ;
    :itemId "phq9" ;
    rdfs:label "Thoughts that you would be better off dead or of hurting yourself in some way"@en ;
    :assesses :SuicidalThoughts ;
    :hasResponseScale :PHQ9_ResponseScale .

:GAD7_Item1 a :QuestionnaireItem ;
    :itemId "gad1" ;
    rdfs:label "Feeling nervous, anxious, or on edge"@en ;
    :assesses :Anxiety ;
    :hasResponseScale :GAD7_ResponseScale .

:GAD7_Item4 a :QuestionnaireItem ;
    :itemId "gad4" ;
    rdfs:label "Trouble relaxing"@en ;
    :assesses :Candidate_Anxiety ;
    :hasResponseScale :GAD7_ResponseScale .

:GAD7_Item6 a :QuestionnaireItem ;
    :itemId "gad6" ;
    rdfs:label "Becoming easily annoyed or irritable"@en ;
    :assesses :FeelingIrritable ;
    :hasResponseScale :GAD7_ResponseScale .

:ESS_Item4 a :QuestionnaireItem ;
    :itemId "epw4" ;
    rdfs:label "As a passenger in a car for an hour without a break"@en ;
    :assesses :Candidate_DaytimeSleepiness ;
    :hasResponseScale :ESS_ResponseScale .

:ESS_Item8 a :QuestionnaireItem ;
    :itemId "epw8" ;
    rdfs:label "In a car, while stopped for a few minutes in traffic"@en ;
    :assesses :Candidate_DaytimeSleepiness ;
    :hasResponseScale :ESS_ResponseScale .

########################################################################
# Concepts cliniques (IDs issus de B2/BioPortal ; choix issus de C2)
# owl:sameAs uniquement pour les concepts dont TOUS les items sont Exact.
########################################################################

:MildDepression a :ClinicalConcept ;
    rdfs:label "Mild depression"@en ;
    rdfs:comment "Match(s) Narrower avec SNOMED CT 310495003 (Mild depression) pour phq2; pas d'équivalence (pipeline automatique, non validé manuellement)."@en .

:Fatigue a :ClinicalConcept ;
    rdfs:label "Fatigue"@en ;
    owl:sameAs <http://purl.bioontology.org/ontology/SNOMEDCT/84229001> .

:AttentionDeficitHyperactivityDisorderCombinedType a :ClinicalConcept ;
    rdfs:label "Attention deficit hyperactivity disorder, combined type"@en ;
    rdfs:comment "Match(s) Narrower avec SNOMED CT 31177006 (Attention deficit hyperactivity disorder, combined type) pour phq7; pas d'équivalence (pipeline automatique, non validé manuellement)."@en .

:SuicidalThoughts a :ClinicalConcept ;
    rdfs:label "Suicidal thoughts"@en ;
    owl:sameAs <http://purl.bioontology.org/ontology/SNOMEDCT/6471006> .

:Anxiety a :ClinicalConcept ;
    rdfs:label "Anxiety"@en ;
    owl:sameAs <http://purl.bioontology.org/ontology/SNOMEDCT/48694002> .

:Candidate_Anxiety a :ClinicalConcept, :CandidateProjectConcept ;
    rdfs:label "anxiety"@en ;
    rdfs:comment "No SNOMED CT match found for the concept proposed on item(s) gad4 (pipeline automatique, non validé manuellement)."@en .

:FeelingIrritable a :ClinicalConcept ;
    rdfs:label "Feeling irritable"@en ;
    owl:sameAs <http://purl.bioontology.org/ontology/SNOMEDCT/55929007> .

:Candidate_DaytimeSleepiness a :ClinicalConcept, :CandidateProjectConcept ;
    rdfs:label "daytime sleepiness"@en ;
    rdfs:comment "No SNOMED CT match found for the concept proposed on item(s) epw4, epw8 (pipeline automatique, non validé manuellement)."@en .
